+b.SECTION.section_menu
	+e.wrap
		+b.section-menu
			+e.menu-top
				+b.menu
					include /blocks/menu/menu-top
			+e.language.en
				+b.BUTTON.button_lang RU
			+e.language.ru
				+b.BUTTON.button_lang EN
			button.burger(type="button" aria-label="Menu" aria-expanded="false")
				span.burger__line
				span.burger__line
				span.burger__line
	.mobile-menu
		button.mobile-menu__close(type="button" aria-label="Close")
			span.mobile-menu__close-line
			span.mobile-menu__close-line
		nav.mobile-menu__nav
			+b.menu
				include /blocks/menu/menu-top
		.mobile-menu__language.en
			+b.BUTTON.button_lang RU
		.mobile-menu__language.ru
			+b.BUTTON.button_lang EN
