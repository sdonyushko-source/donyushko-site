.section-services
	padding $blockPaddingTop 0

	&__services
		padding-top $blockPaddingTop
		margin-bottom 130px
		display inline-block

	&__services-row
		display flex

		&:not(:first-child)
			margin-top 100px

	&__service
		flex 1
		margin-right 85px

	&__get-in-touch
		& > a
			font-size 20px
			padding 14px 52px