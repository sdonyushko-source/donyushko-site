.case-panel
	margin-bottom 40px
	padding 90px 85px
	color #fff
	background-color #131316

	&_t6
		background-color #674caf

	&_t7
		background-color #109c8b

	&_t8
		background-color #2e68ee

	&_t9
		background-color #6e52e2

	&.case-panel_plain
		background-color transparent
		color $mainColor
		padding 50px 0
		margin-bottom 0
		max-width 1100px
		margin-left auto
		margin-right auto

		@media w-640
			padding-top 30px
			padding-bottom 30px

	@media w-1185
		padding 60px 40px

	@media w-640
		padding 40px 20px
		margin-bottom 24px

	&__lead
		font-size 34px
		font-weight 300
		line-height 1.35
		max-width 860px

		@media w-640
			font-size 22px

	&__bold
		font-weight bold

	&__text
		margin-top 22px
		font-size 22px
		font-weight 300
		line-height 1.5
		max-width 820px
		opacity .9

		@media w-640
			font-size 18px

	&__images
		margin-top 60px

		@media w-640
			margin-top 36px

		&_row
			display flex
			justify-content space-between

	&__image
		display block
		width 100%
		height auto
		margin-bottom 40px
		filter drop-shadow(0 10px 24px rgba(0, 0, 0, .16))

		&:last-child
			margin-bottom 0

	&__images_row &__image
		width calc((100% - 60px) / 3)
		margin-bottom 0
