.case
	padding $blockPaddingTop 0

	&__tag
		font-size 16px
		padding-bottom 20px

	&__title
		font-size 48px
		font-weight bold
		line-height 1.15
		max-width 900px
		padding-bottom 40px

		@media w-640
			font-size 32px
			padding-bottom 24px

	&__lead
		font-size 28px
		line-height 1.4
		max-width 900px

		@media w-640
			font-size 20px

		&:not(:last-of-type)
			padding-bottom 24px

	&__meta
		margin-top 50px
		padding 30px 0
		border-top 1px solid $mainColor
		border-bottom 1px solid $mainColor

	&__meta-row
		display flex
		padding 6px 0
		font-size 18px

		@media w-640
			display block
			padding 10px 0

	&__meta-key
		flex 0 0 160px
		opacity .6

	&__meta-value
		flex 1

	&__link
		padding-top 30px
		font-size 22px

	&__link-a
		font-weight 500
		text-decoration underline

	&__heading
		margin-top 110px
		padding-bottom 24px
		font-size 34px
		font-weight bold

		@media w-640
			margin-top 70px
			font-size 28px

	&__text
		font-size 20px
		line-height 1.55
		max-width 860px

		@media w-640
			font-size 18px

		&:not(:last-of-type)
			padding-bottom 18px

	&__images
		margin-top 40px

		&_row
			display flex
			justify-content space-between

	&__image
		display block
		width 100%
		height auto
		margin-bottom 30px

	&__images_row &__image
		width calc((100% - 40px) / 3)
		margin-bottom 0

	&__back
		margin-top 110px

	&__back-link
		font-weight 500
		font-size 18px
		text-decoration underline
