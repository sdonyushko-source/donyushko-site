.section-main
	padding $blockPaddingTop 0

	&__contact
		padding 30px 0 20px 0
		display flex
		align-items center

	&__avatar
		margin-right 40px

	&__button
		border 2px solid $mainColor

	&__projects-headline
		padding-bottom 20px
		margin-bottom 50px
		border-bottom 1px solid $mainColor
		display flex
		justify-content space-between
		align-items flex-end

	&__headline
		font-weight bold
		font-size 40px

	&__project
		&:not(:first-child)
			padding-top $blockPaddingTop

	&__show-more
		margin-top 70px

	&__more
		display inline-flex
		align-items center

		&_text
			font-weight 500
			font-size 18px

		&_arrow
			transition $transitionDefault
			padding 0 5px 0 10px

			^[-1]:hover &
				padding 0 0 0 15px

.main-project
	position sticky
	display inline-block
	margin-bottom: 75px;

	&__main-link
		cursor pointer

	&__main-picture
		display block

	&__main-description
		padding 30px
		width 500px
		position absolute
		bottom -85px
		left 55px
		background-color $colorWhite

	&__description
		padding-bottom 20px
		background-color $colorWhite
		font-size 28px

		^[0]:hover &
			text-decoration underline

	&__bold
		font-weight bold

	&__tag
		font-weight normal
		font-size 16px

@media w-640
	.section-main__contact
		flex-direction column
		align-items stretch

	.section-main__avatar
		margin 0 0 20px 0

	.section-main__button
		display block
		width 100%

		.pixel-button
			width 100%
			height 44px

		.pixel-button__pixel
			display none

	.main-project
		display block
		width 100%
		margin-bottom 110px

		&__main-description
			width calc(100% - 40px)
			left 50%
			bottom -70px
			padding 24px 20px
			text-align center
			transform translateX(-50%)

		&__description
			padding-bottom 14px
			font-size 22px

	.main-project img
	.project-summary img
		display block
		width 100%
		height auto
		aspect-ratio 1 / 1
		object-fit cover
